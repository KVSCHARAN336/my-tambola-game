rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Tambola Game Rooms
    match /rooms/{roomId} {
      // Helper functions for security validation
      function isAuth() {
        return request.auth != null && request.auth.uid != null;
      }

      function isHost() {
        return isAuth() && resource.data.hostUid == request.auth.uid;
      }

      function isValidCode(code) {
        return code is string && code.size() == 6;
      }

      function isValidAutoInterval(val) {
        return val is number && val >= 3 && val <= 30;
      }

      // 1. Read: Authenticated users can read room state
      allow read: if isAuth();

      // 2. Room Creation: Only authenticated host can create room
      allow create: if isAuth()
        && request.resource.data.hostUid == request.auth.uid
        && isValidCode(request.resource.data.code)
        && request.resource.data.code == roomId
        && request.resource.data.createdAt is number
        && request.resource.data.status in ['waiting', 'active']
        && isValidAutoInterval(request.resource.data.autoInterval)
        && request.resource.data.calledNumbers is list
        && request.resource.data.calledNumbers.size() == 0
        && request.resource.data.currentNumber == null
        && request.resource.data.keys().hasOnly([
          'code',
          'hostUid',
          'currentNumber',
          'calledNumbers',
          'hostHeartbeat',
          'autoInterval',
          'createdAt',
          'status'
        ]);

      // 3. Room Updates: ONLY the authenticated room host can mutate game state
      // Non-hosts have ZERO update permissions on room documents
      allow update: if isHost()
        // Core identity & ownership fields are immutable
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.code == resource.data.code
        && request.resource.data.createdAt == resource.data.createdAt
        // Restrict allowed fields on update (reject unexpected fields)
        && request.resource.data.keys().hasOnly([
          'code',
          'hostUid',
          'currentNumber',
          'calledNumbers',
          'hostHeartbeat',
          'autoInterval',
          'createdAt',
          'status'
        ])
        // Valid game state mutations
        && isValidAutoInterval(request.resource.data.autoInterval)
        && request.resource.data.status in ['waiting', 'active', 'completed']
        && request.resource.data.calledNumbers is list
        && request.resource.data.calledNumbers.size() <= 90
        && (
          request.resource.data.currentNumber == null
          || (
            request.resource.data.currentNumber is number
            && request.resource.data.currentNumber >= 1
            && request.resource.data.currentNumber <= 90
          )
        );

      // 4. Room Deletion: ONLY the authenticated room host
      allow delete: if isHost();

      // 5. Players Subcollection: rooms/{roomId}/players/{playerUid}
      match /players/{playerUid} {
        // Authenticated users can view player roster
        allow read: if isAuth();

        // Create: Player creates strictly their own player document
        allow create: if isAuth()
          && request.auth.uid == playerUid
          && request.resource.data.id == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.joinedAt is number
          && request.resource.data.keys().hasOnly(['id', 'name', 'joinedAt']);

        // Update: Player updates strictly their own player record
        allow update: if isAuth()
          && request.auth.uid == playerUid
          && request.resource.data.id == request.auth.uid
          && request.resource.data.joinedAt == resource.data.joinedAt
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 30
          && request.resource.data.keys().hasOnly(['id', 'name', 'joinedAt']);

        // Delete: Either the player themselves (leaves room) OR the host (kicks player)
        allow delete: if isAuth() && (
          request.auth.uid == playerUid
          || request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostUid
        );
      }
    }
  }
}
